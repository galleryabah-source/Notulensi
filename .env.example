# Self-hosted Notulensi production environment.
# Do NOT commit real secrets. Prefer Windows Machine environment variables for production.

# PostgreSQL connection string used by the API/server modules.
DATABASE_URL=postgresql://notulensi:CHANGE_ME@127.0.0.1:5432/notulensi

# Admin authentication. Generate a unique random value for production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SALT=CHANGE_ME
ADMIN_PASSWORD_HASH=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

# Self-hosted HTTP listener. Keep localhost when using Caddy/tunnel as the public edge.
NOTULENSI_HOST=127.0.0.1
NOTULENSI_PORT=3000
NOTULENSI_TRUST_PROXY=1
NOTULENSI_API_RATE_LIMIT=180
