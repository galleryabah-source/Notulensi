{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notulensi-lite",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".github/**",
      "cloudflare/**",
      "phase17-execution/**",
      "server/**",
      "api/**"
    ]
  }
}
