PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/meeting_intelligence
DATABASE_SSL=true
DB_POOL_MAX=10
JWT_SECRET=replace-with-at-least-32-random-bytes
SHARE_TOKEN_PEPPER=replace-with-a-different-at-least-32-random-secret
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=meeting-intelligence-api
CORS_ORIGIN=https://your-frontend.example.com
TRUST_PROXY=1
RESOLVE_RATE_LIMIT=60
